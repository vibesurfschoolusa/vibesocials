# =============================================================================
# Vibe Socials - environment variables (template)
#
# Copy this file to .env.local and fill in real values for the features you
# actually use. .env.local is gitignored and is read by `next dev`,
# `next start`, and the Prisma CLI. EVERY value below is a placeholder - none
# are real secrets.
#
# IMPORTANT: on a developer machine DATABASE_URL should point at a LOCAL or a
# throwaway STAGING database, never production. `npm run dev` runs a predev
# guard (scripts/dev-db-guard.mjs) that refuses to start against a remote host
# unless you opt in with DEV_DB_OK=1. See docs/STAGING_SETUP.md.
# =============================================================================

# --- Database (Prisma) -------------------------------------------------------
# Postgres connection string; read by prisma/schema.prisma. Keep it pointed at
# localhost or a disposable staging branch during development.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vibesocials?schema=public"
# Optional, production only: the DIRECT (non-pooler) Neon host of the same
# branch. Used ONLY by `prisma migrate deploy` at build time
# (scripts/migrate-on-vercel-prod.mjs); the running app never reads it. In
# production DATABASE_URL is the pooled "-pooler" host, but Prisma Migrate needs
# a direct connection for its advisory lock. Unset = migrate with DATABASE_URL.
# See docs/STAGING_SETUP.md ("Production database connections").
DIRECT_URL=""

# --- Auth (NextAuth v4) ------------------------------------------------------
# Canonical base URL of this deployment; used for OAuth redirects and email links.
NEXTAUTH_URL="http://localhost:3000"
# Secret used to sign/encrypt the session JWT; required in production.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=""
# 32-byte key (base64) used to encrypt SocialConnection OAuth tokens at rest
# in Postgres. Generate with:  openssl rand -base64 32
# When unset, local/test store plaintext; production SEAL throws (required).
# REQUIRED in production — set in Vercel and redeploy after migrate deploy.
TOKEN_ENCRYPTION_KEY=""
# Optional "Continue with Google" sign-in (src/lib/googleSso.ts). When unset
# (the default) the Google provider is not registered and no button renders.
# Create a SEPARATE Google OAuth client from the platform-connection one below
# (GOOGLE_GBP_*): scopes are just openid/email/profile and the authorized
# redirect URI is  <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_SSO_CLIENT_ID=""
GOOGLE_SSO_CLIENT_SECRET=""

# --- Blob storage (Vercel Blob) ----------------------------------------------
# Read/write token for @vercel/blob; powers media uploads
# (src/app/api/upload/route.ts). Read implicitly by the SDK.
# Shape: vercel_blob_rw_<storeId>_<secret>
BLOB_READ_WRITE_TOKEN=""
# Optional. This deployment's Blob store id, the <storeId> in the token above
# (a leading "store_" is accepted). Only used when BLOB_READ_WRITE_TOKEN is
# unset or malformed: the token wins. Set it to the SAME store as the token or
# leave it unset; a store id that differs from the token's store is a
# misconfiguration (there is no multi-store support).
BLOB_STORE_ID=""
# Store pin for client-supplied blobUrl values (POST /api/media, POST
# /api/posts): when the store id is known (from the token, else BLOB_STORE_ID),
# only OUR store's Vercel Blob hosts (<storeId>.public.blob.vercel-storage.com
# and the .private. twin) are accepted. Another store's Blob host is rejected.
# When no store id is known, any Vercel Blob host is accepted.
# Escape hatch: list a host here (and redeploy) to accept it anyway, whether a
# custom CDN or another Blob store's host. Optional comma-separated hostnames,
# e.g. cdn.example.com,media.myco.io
BLOB_ALLOWED_HOSTS=""

# --- Email (Resend) ----------------------------------------------------------
# Resend API key. When unset, notification emails are skipped (never throw).
# When set, live publish requires emailVerifiedAt (soft verify gate).
RESEND_API_KEY=""
# From address for notification emails, e.g. "Vibe Socials <no-reply@example.com>".
NOTIFICATIONS_FROM=""

# --- AI / captions (SpaceXAI preferred; OpenAI fallback) ----------------------
# Prefer XAI_API_KEY (https://api.x.ai/v1). OPENAI_API_KEY is used only when XAI
# is unset. Optional model overrides below.
XAI_API_KEY=""
# XAI_TEXT_MODEL="grok-4.5"
# XAI_VISION_MODEL="grok-4.5"
OPENAI_API_KEY=""
# OPENAI_TEXT_MODEL="gpt-4o-mini"
# OPENAI_VISION_MODEL="gpt-4o"

# --- Error reporting (Sentry) ------------------------------------------------
# Server-side DSN. When unset, Sentry is fully disabled at build AND runtime.
SENTRY_DSN=""
# Browser DSN (inlined into the client bundle).
NEXT_PUBLIC_SENTRY_DSN=""
# Build-time only: source-map upload auth token (unset = no upload attempted).
SENTRY_AUTH_TOKEN=""
# Build-time only: Sentry org and project slugs for source-map upload.
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Background jobs (Inngest) -----------------------------------------------
# Read implicitly by the Inngest SDK (src/lib/inngest.ts sets only id/name).
# In production ("cloud" mode) inngest.send() requires an event key or it
# throws; the /api/inngest serve endpoint uses the signing key to verify calls.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Optional. The highest concurrency limit one Inngest function may declare on
# your Inngest plan (default 5, the free plan). Every function limit below is
# clamped to it, because the sync rejects the whole app when one limit is above
# the plan's. Set it to the new plan's limit after upgrading (e.g. 100 on Pro).
INNGEST_PLAN_CONCURRENCY=""
# Optional. Concurrent publish steps, shared by the publish and retry functions
# (src/server/jobs/publishFlowControl.ts). Positive integers; a missing or
# invalid value uses the default. Both are clamped to INNGEST_PLAN_CONCURRENCY.
# They take effect at the next deploy/sync.
# Per workspace (default 20): keeps a ~300-post burst draining in ~40 min, inside the 2 h stuck reconciler.
PUBLISH_CONCURRENCY_PER_WORKSPACE=""
# Global (default 80): 80% of the 100 concurrent steps Inngest Pro includes, so
# the scanner, notifications and sweeps keep room. Raise it after buying slots.
PUBLISH_CONCURRENCY_GLOBAL=""
# Optional. Platforms that upload a video above 50 MiB in bounded chunks across several steps instead
# of loading it whole (src/server/platforms/largeUpload.ts). Comma-separated, any of: youtube,x,tiktok,linkedin.
# Empty, missing, "none" or a value with no valid name all mean no platform (unknown names are ignored), so the new
# path is OFF everywhere by default: it relies on vendor behaviour we couldn't confirm. Switch platforms on one at a
# time after a promotion (docs/STAGING_SETUP.md, "Enabling large-video uploads"). Takes effect at the next deploy;
# a result that already has saved upload state keeps the new path.
LARGE_UPLOAD_PLATFORMS=""

# --- Platform OAuth / social integrations ------------------------------------
# Each *_REDIRECT_URI / *_CALLBACK_URL must match the provider app config exactly.

# Meta - Facebook Pages + Instagram (share the same app credentials)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_PAGE_REDIRECT_URI="http://localhost:3000/api/auth/facebook_page/callback"
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/auth/instagram/callback"
# Verify token you choose when subscribing the Meta webhook
# (src/app/api/webhooks/meta/route.ts).
META_WEBHOOK_VERIFY_TOKEN=""

# Google - Business Profile + YouTube (share the same OAuth client)
GOOGLE_GBP_CLIENT_ID=""
GOOGLE_GBP_CLIENT_SECRET=""
GOOGLE_GBP_REDIRECT_URI="http://localhost:3000/api/auth/google_business_profile/callback"
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/auth/youtube/callback"
# Optional. YouTube videos.insert calls allowed per Pacific day (src/server/platforms/youtubeQuota.ts).
# YouTube's own bucket is 100 calls/day and resets at midnight Pacific; raise this only after Google
# approves a quota extension. A non-negative integer; a missing or invalid value uses 100, and 0 disables YouTube uploads.
YOUTUBE_DAILY_UPLOAD_LIMIT=100

# LinkedIn
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:3000/api/auth/linkedin/callback"

# Pinterest (API v5; src/lib/pinterestApi.ts). App id and secret from
# https://developers.pinterest.com/apps/ ; add the redirect URI to the app there.
# While any of the three is unset, Settings does not list Pinterest.
PINTEREST_APP_ID=""
PINTEREST_APP_SECRET=""
PINTEREST_REDIRECT_URI="http://localhost:3000/api/auth/pinterest/callback"

# TikTok (see docs/TIKTOK_SETUP.md)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/auth/tiktok/callback"

# X / Twitter (OAuth 1.0a)
X_CONSUMER_KEY=""
X_CONSUMER_SECRET=""
X_CALLBACK_URL="http://localhost:3000/api/auth/x/callback"

# --- AI & geocoding ----------------------------------------------------------
# OpenAI key for caption enhancement + review draft responses
# (src/app/api/posts/{auto-caption,enhance-caption}, reviews/draft-response).
OPENAI_API_KEY=""
# Google Maps key for location geocoding (src/app/api/geocode).
GOOGLE_MAPS_API_KEY=""

# --- Usage limits per workspace (optional; src/lib/usageLimits.ts) -----------
# Posts going out per UTC day per workspace; whole number, default 20, 0 blocks all.
LIMIT_POSTS_PER_DAY=""
# X posts published per UTC calendar month per workspace; whole number, default 30.
LIMIT_X_POSTS_PER_MONTH=""
# YouTube uploads published per Pacific day per workspace; whole number, default 10.
LIMIT_YOUTUBE_UPLOADS_PER_DAY=""
# Media storage per workspace in megabytes; whole number, default 2048.
LIMIT_STORAGE_MB=""

# --- App runtime (optional) --------------------------------------------------
# Logger verbosity: error | warn | info | debug (src/lib/logger.ts).
LOG_LEVEL=""
# Filesystem root for the local media-storage driver in self-host/dev
# (src/server/storage/localStorage.ts).
MEDIA_UPLOAD_ROOT=""

# --- E2E only (Playwright / CI - never set these in production) ---------------
# Throwaway Postgres for the Playwright core flows; playwright.config.ts threads
# it through as the booted server's DATABASE_URL. See app/e2e/README.md.
E2E_DATABASE_URL=""
# Capability gates that light specific core flows (see app/e2e/README.md).
E2E_UPLOAD_STUBS_READY=""
E2E_STUBS_READY=""
# Blob API base-URL overrides that point @vercel/blob at the mock blob server
# during E2E. Leave unset in real environments (the SDK uses its default).
VERCEL_BLOB_API_URL=""
NEXT_PUBLIC_VERCEL_BLOB_API_URL=""

# NOTE: NODE_ENV, NEXT_RUNTIME and CI are provided by Node / Next / the CI
# runner - do not set them here. DEV_DB_OK is a one-off shell opt-in for the
# dev-db guard (e.g. `DEV_DB_OK=1 npm run dev`), not a stored value.
