datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Platform {
  tiktok
  youtube
  x
  linkedin
  instagram
  google_business_profile
  facebook_page
  pinterest
}

enum PostJobStatus {
  pending
  in_progress
  completed
  failed
  // Roadmap Phase 5 (scheduling + drafts). DB-additive, but NOT free at the
  // TypeScript layer: any exhaustive `Record<PostJobStatus, …>` / switch on
  // `.status` (e.g. JOB_STATUS_META in components/activity/post-job-card.tsx)
  // must enumerate these or `tsc` fails. `draft`/`scheduled` are non-terminal
  // (their media is kept by the retention sweep); `cancelled` is terminal.
  draft
  scheduled
  cancelled
}

enum PostJobResultStatus {
  pending
  success
  failed
}

// Team Workspaces. `owner` is the workspace creator (or an invite-accepted
// member later promoted — v1 has no promotion flow, out of scope); `member`
// is anyone who joined via invite link. See design doc §1 permission matrix.
enum WorkspaceRole {
  owner
  member
}

// Account lifecycle (scale-readiness spec §A). Discriminates the two kinds of
// short-lived, single-use AccountToken: password reset (60 min TTL) and email
// verification (7 day TTL). See src/lib/accountToken.ts for the TTLs.
enum AccountTokenType {
  password_reset
  email_verify
}

model User {
  id                   String    @id @default(cuid())
  // Always stored normalizeEmail() (trim + lowercase). Lookups and unique
  // constraint assume that form — see src/lib/email.ts.
  email                String    @unique
  name                 String?
  passwordHash         String?
  // Account lifecycle (scale-readiness spec §A). Null until the user verifies
  // their email. The backfill migration grandfathers every EXISTING user as
  // verified (stamped CURRENT_TIMESTAMP) so this rollout locks nobody out.
  emailVerifiedAt      DateTime?
  // When this account was first signed into with Google SSO (null = never).
  // A Google sign-in only auto-links into an existing account that is already
  // linked, or that has no password — see planGoogleSsoLink in
  // src/lib/googleSso.ts.
  googleLinkedAt       DateTime?
  // Roadmap Phase 6 (notifications). Gates the best-effort post-outcome email
  // (see server/notifications/postOutcomeEmail.ts) — independent of whether
  // RESEND_API_KEY is configured, which is the other, env-level gate. Defaults
  // to true so existing users start opted in, matching the spec (§7.2).
  notifyOnPostComplete Boolean   @default(true)
  // Bumped on password reset so outstanding next-auth JWTs (which embed the
  // prior version) fail getCurrentUser until the user signs in again.
  sessionVersion       Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspaceMemberships WorkspaceMember[]
  socialConnections    SocialConnection[]
  mediaItems           MediaItem[]
  postJobs             PostJob[]
  postMetrics          PostMetric[]
  accountTokens        AccountToken[]
}

// Short-lived server-side store for OAuth handshakes that cannot put secrets
// in signed state (X OAuth 1.0a). Keyed by the provider request token; only
// the token secret + owner context live here — never long-lived access tokens.
// Rows expire and are deleted on successful callback or opportunistic cleanup.
model OAuthHandshake {
  // Provider request token (oauth_token) — unique per handshake.
  token       String   @id
  tokenSecret String
  userId      String
  workspaceId String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

// Team Workspaces. The tenant: owns connections, media, posts, metrics, and
// brand settings (caption footer). Every user gets a personal workspace at
// registration (existing users via backfill migration), so solo use is
// unchanged. See design doc §1-2.
model Workspace {
  id              String   @id @default(cuid())
  name            String
  companyWebsite  String? // caption footer moves here (brand-level)
  defaultHashtags String?
  // Approval workflow (2026-07-26). When true, a MEMBER's post that would
  // publish or schedule is held as a `draft` + `submittedForApprovalAt` until
  // an owner approves it. Owners' own posts are never held (they approve).
  requireApproval Boolean  @default(false)
  // Usage limits (2026-11-10). Null = use LIMIT_* from the environment, else the
  // built-in default (src/lib/usageLimits.ts). Zero blocks everything.
  limitPostsPerDay          Int?
  limitXPostsPerMonth       Int?
  limitYoutubeUploadsPerDay Int?
  limitStorageMb            Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members            WorkspaceMember[]
  invites            WorkspaceInvite[]
  connections        SocialConnection[]
  pendingConnections PendingConnection[]
  mediaItems         MediaItem[]
  postJobs           PostJob[]
  postMetrics        PostMetric[]
}

// (workspace, user, role) membership row. The creator is `owner`; invite
// joiners are `member`. One row per (workspace, user) — see @@unique below.
model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(member)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// Owner-created join link. Random 43-char base64url token (32 bytes); only
// the SHA-256 hash is stored — the raw token appears just once, in the
// copied link. Unlimited uses until revoked (revokedAt) or past expiresAt
// (7 days from creation). createdById is attribution only, no relation.
model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  tokenHash   String    @unique // sha256 hex of the raw token
  createdById String
  expiresAt   DateTime
  revokedAt   DateTime?
  usedCount   Int       @default(0)
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // 2026-11-01 scale audit: invite GET/POST/DELETE and member-removal revoke
  // filter by workspace + not-yet-revoked.
  @@index([workspaceId, revokedAt])
}

// Account lifecycle (scale-readiness spec §A). Short-lived, single-use tokens
// for password reset and email verification. Same hash-only storage model as
// WorkspaceInvite: a random 43-char base64url token (32 bytes) is emailed once
// in a URL FRAGMENT; only its SHA-256 hex digest (`tokenHash`, unique) is
// persisted — the raw token is never stored and cannot be recovered. `usedAt`
// marks single-use consumption; `expiresAt` is stamped by issueAccountToken per
// AccountTokenType TTL. Cascade-deleted with the owning user.
model AccountToken {
  id        String           @id @default(cuid())
  userId    String
  type      AccountTokenType
  tokenHash String           @unique // sha256 hex of the raw token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model SocialConnection {
  id                   String    @id @default(cuid())
  userId               String
  workspaceId          String
  platform             Platform
  accessToken          String
  refreshToken         String?
  expiresAt            DateTime?
  accountIdentifier    String
  scopes               Json?
  metadata             Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  // Connection health (Roadmap Phase 4). `expiresAt` is only the ~1h
  // auto-refreshed access-token expiry (null for X) and is NOT a health
  // signal. `needsReconnect` is the real signal: set when a token *refresh*
  // terminally fails (Google invalid_grant) or a platform client maps a 401
  // to its `*_RECONNECT_REQUIRED` code — see server/platforms/connectionHealth.ts.
  // Cleared on the next successful OAuth callback write. Never set alongside
  // accessToken/refreshToken in the same update (see connectionHealth.ts).
  needsReconnect       Boolean   @default(false)
  lastRefreshErrorCode String?
  refreshFailedAt      DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Team Workspaces. Tenant owner of this connection; userId above stays as
  // the connecting user's attribution only. Cascade: deleting a workspace
  // removes its connections (and their cascaded results/metrics).
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  postJobResults PostJobResult[]

  // One connected account per platform per workspace (was per-user
  // pre-workspaces); members of a workspace share the same connection.
  @@unique([workspaceId, platform], name: "workspaceId_platform")
  // 2026-11-01 scale audit: User -> SocialConnection ON DELETE CASCADE seeks by
  // userId; without an index each user delete scans the table.
  @@index([userId])
}

// 2026-11-09: an OAuth connect that found several accounts, waiting for the
// user to choose one. `payload` is sealSecret(JSON) — it holds tokens.
model PendingConnection {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  platform    Platform
  payload     String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
}

model MediaItem {
  id                   String    @id @default(cuid())
  userId               String
  workspaceId          String
  storageLocation      String
  originalFilename     String
  mimeType             String
  sizeBytes            Int
  baseCaption          String
  perPlatformOverrides Json?
  metadata             Json?
  createdAt            DateTime  @default(now())
  // Retention lifecycle (Roadmap Phase 1). Soft-delete: the row is kept
  // (history/captions depend on it) and only the blob is removed; `deletedAt`
  // marks when the blob was removed. `lastUsedAt` is stamped when the media is
  // attached to a post and drives age-based retention (null = never-posted
  // library upload, which is exempt from the sweep).
  deletedAt            DateTime?
  lastUsedAt           DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Team Workspaces. Tenant owner; userId above stays as uploader
  // attribution. Cascade: deleting a workspace removes its media.
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  postJobs  PostJob[]

  @@index([workspaceId])
  // 2026-11-01 scale audit: the media library list
  // (`where workspaceId, deletedAt: null ORDER BY createdAt DESC, id DESC`) is
  // served and ordered by this index, so a keyset page needs no sort. `id` is
  // the tiebreaker that makes the order total. Supersedes @@index([workspaceId])
  // above, which stays for now (no drops in this phase).
  @@index([workspaceId, deletedAt, createdAt, id])
  // 2026-11-01 scale audit: deleteBlobUnlessShared counts the OTHER live rows
  // that share a storageLocation before it removes the blob, and the retention
  // sweep does the same. Both look the column up by equality only (`=` / `IN`),
  // so this is a HASH index: unlike a btree it has no index-row size limit, so a
  // very long stored URL can never make CREATE INDEX (or a later insert) fail.
  @@index([storageLocation], type: Hash)
  // 2026-11-01 scale audit: User -> MediaItem ON DELETE CASCADE seeks by userId.
  @@index([userId])
  // 2026-11-01 scale audit (jobs, media retention): the hourly retention sweep
  // keyset-pages `deletedAt IS NULL AND createdAt < cutoff ORDER BY createdAt, id`
  // (every eligible row satisfies createdAt < cutoff, because lastUsedAt >=
  // createdAt), so this index serves the filter, the order and the cursor
  // without a sort or a scan of the already-swept rows.
  @@index([deletedAt, createdAt, id])
}

model PostJob {
  id                   String        @id @default(cuid())
  userId               String
  workspaceId          String
  mediaItemId          String
  status               PostJobStatus @default(pending)
  // Roadmap Phase 5. `scheduledFor` is null for immediate posts and set for
  // `scheduled` jobs; the cron due-scanner claims `status=scheduled` rows whose
  // `scheduledFor <= now` (hence the composite index). `baseCaption` /
  // `perPlatformOverrides` snapshot the composer content for EVERY job (all
  // intents since the 2026-11-01 audit; deferred-only before) so it is durable
  // and editable (PATCH) without mutating the shared MediaItem; immediate posts
  // also carry it in the event payload. The cron/promote/retry resolve caption
  // + overrides as ONE unit (resolvePostCaptionSource): a job with its own
  // `baseCaption` uses its own `perPlatformOverrides` as-is (null = no
  // overrides); only when `baseCaption` is null (a legacy row) do BOTH come
  // from the MediaItem.
  scheduledFor         DateTime?
  baseCaption          String?
  perPlatformOverrides Json?
  // Roadmap Phase 5 (review B1). Per-post platform publishing metadata —
  // `{ tiktok?, youtube? }` — snapshotted for `scheduled`/`draft` jobs ONLY.
  // Immediate posts carry this in the event payload; deferred jobs have no
  // event yet, so without persisting it the cron/publish path would fall back
  // to each client's default and SILENTLY ESCALATE a user's YouTube "private"
  // to "unlisted". The due-scanner/publish-promote replays it into the event.
  publishMetadata      Json?
  // Approval workflow (2026-07-26). Non-null = this draft is (or was) awaiting
  // owner approval; `approvedAt`/`approvedByUserId` record the decision. A
  // submitted-but-unapproved job that ends `cancelled` was REJECTED. Derived by
  // lib/approval.ts deriveApprovalState() — deliberately NOT a new
  // PostJobStatus (see the enum's comment above).
  submittedForApprovalAt DateTime?
  approvedAt             DateTime?
  approvedByUserId       String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Team Workspaces. Tenant owner; userId above stays as the creator who
  // pressed publish (post-outcome email recipient — see
  // server/notifications/postOutcomeEmail.ts). Cascade: deleting a workspace
  // removes its post jobs.
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mediaItem MediaItem       @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  results   PostJobResult[]

  // Due-scanner lookup: WHERE status = 'scheduled' AND scheduledFor <= now.
  @@index([status, scheduledFor])
  @@index([workspaceId])
  // Backs GET /api/posts keyset pagination: the per-workspace total order
  // `ORDER BY createdAt DESC, id DESC` (Postgres backward-scans this composite
  // for the DESC direction, so no extra sort/filesort). Keep @@index([workspaceId])
  // above — other queries filter on workspaceId alone and don't need the sort key.
  @@index([workspaceId, createdAt, id])
  // Approval workflow: the Queue's "awaiting approval" lookup filters on
  // workspace + submittedForApprovalAt IS NOT NULL.
  @@index([workspaceId, submittedForApprovalAt])
  // 2026-11-01 scale audit: media delete and retention counts look up jobs by
  // mediaItemId + status; also backs MediaItem -> PostJob ON DELETE CASCADE.
  @@index([mediaItemId, status])
  // 2026-11-01 scale audit: Queue `?status=scheduled,draft` filters by
  // workspace + status and orders by createdAt.
  @@index([workspaceId, status, createdAt])
  // 2026-11-01 scale audit: User -> PostJob ON DELETE CASCADE seeks by userId.
  @@index([userId])
}

model PostJobResult {
  id                 String              @id @default(cuid())
  postJobId          String
  platform           Platform
  // Nullable + onDelete: SetNull (2026-11-01 audit): removing a connection
  // (Disconnect / Switch account) must keep the publish history — Activity and
  // Publish health read these rows — so the FK is cleared, not cascaded. A null
  // id means "the connection that published this was removed"; a retry then
  // publishes through the workspace's CURRENT connection for the platform and
  // repoints the row (inngest-functions.ts retryPlatforms).
  socialConnectionId String?
  status             PostJobResultStatus @default(pending)
  externalPostId     String?
  // 2026-11-08: the post's public link, when the platform's id is not one
  // (Instagram media ids). Written by the publish step from what the platform
  // returned; Activity prefers it over a link built from externalPostId.
  externalPostUrl    String?
  errorCode          String?
  errorMessage       String?
  // 2026-11-01 scale audit (jobs H6): the per-result publish claim. A platform
  // step claims its result with one conditional write (status pending AND
  // claimRunId null) before it calls the platform, so two runs of a job — a
  // duplicate event, a retry overlapping a late original — can never both
  // publish it. claimRunId is the Inngest runId of the step about to call the
  // platform; claimedAt is when. A claim is only ever held inside ONE step
  // (<= 300 s, publishBudget.ts): a pending row that still has one after that
  // lost its run mid-call, so the reconciler and onFailure mark it
  // PUBLISH_UNCONFIRMED (the post may be live) instead of "retry me". The retry
  // route clears both when it re-queues a failed result. Nullable columns, not a
  // new PostJobResultStatus value: `pending` keeps its meaning for every reader
  // (and the old deployment) and nothing else needs to know about claims.
  claimRunId         String?
  claimedAt          DateTime?
  // 2026-11-01 scale audit (platform limits): set while a platform step waits out
  // a rate limit or quota refusal (RATE_LIMITED / DAILY_LIMIT in errorCode). The
  // result stays `pending` and holds NO claim; the run sleeps (step.sleepUntil)
  // until this instant and claims it again, which clears it. The 2 h reconciler
  // and the 6 h stale sweep skip a job with a pending result whose deferredUntil
  // is still ahead (or ended less than their window ago), so a ~20 h YouTube
  // wait is not mistaken for a dead run. Nullable, like the claim: the previous
  // deployment simply ignores it.
  deferredUntil      DateTime?
  // 2026-11-01 scale audit (jobs): when the hourly YouTube metrics sync last
  // ATTEMPTED this result - found, not found or error alike. The sync picks the
  // least-recently-checked results first (NULL first) and skips any checked
  // within the last 50 minutes (METRICS_MIN_REFRESH_MS, below the hourly cron so
  // start-time jitter cannot skip a cycle). PostMetric.fetchedAt cannot order the
  // queue: a deleted or private video never gets a metric row, so it would sort
  // first forever and starve the rest. Written by a raw UPDATE (youtubeMetricsSync.ts), not
  // updateMany, so @updatedAt is NOT bumped: publish-health reads updatedAt as
  // "when the result finished". Nullable: the previous deployment ignores it.
  metricsCheckedAt   DateTime?
  // 2026-11-01 scale audit (db M5, web W16): the owning job's workspace,
  // denormalized so publish-health counts a workspace's recent results from the
  // [workspaceId, updatedAt] index below instead of joining PostJob (~400 ms for
  // every workspace, 0.4-0.9 s for a 50k-post one). Deliberately NOT a relation or
  // foreign key: results already die with their job (PostJob cascade), and an FK
  // would validate the whole table under SHARE ROW EXCLUSIVE locks on both tables
  // while it is built. Nullable so the previous deployment, which does not set it,
  // keeps inserting. Every result-creating write sets it (posting.ts). Existing
  // rows are filled by migration 20261103100100_backfill_post_job_result_workspace_id;
  // rows the previous deployment writes in between (or during a rollback) carry
  // NULL until the hourly stale sweep heals them (resultWorkspaceHeal.ts). Both
  // are raw UPDATEs that never touch updatedAt: publish-health reads it as "when
  // the result finished", and an updateMany would bump @updatedAt.
  workspaceId        String?
  // 2026-11-02 scale audit (jobs, chunked uploads): where a large video upload
  // stands between two Inngest steps, so a platform step can stop at its 225 s
  // budget and the next one (`<stepId>-c<n>`) resume it. Shape (uploadState.ts):
  // { v, runId, platform, kind, savedAt, data, secret? }. `data` is progress and
  // ids only; `secret` is the capability URLs (YouTube session URI, TikTok
  // upload_url, LinkedIn part URLs and metadata) as sealSecret() ciphertext
  // (tokenCrypto.ts), the way SocialConnection tokens are sealed, so no URL is
  // readable in the table, a dump or a log. State of another runId is ignored,
  // so a retry starts fresh. Writes are claim-scoped (updateMany where claimRunId
  // is the run's and status is still pending), so a run that lost its claim cannot
  // write. Cleared by finalizeClaimedResult (both outcomes) and by the retry
  // route's re-queue; kept across a rate-limit deferral and a continuation. A row
  // the reconciler or an onFailure handler fails keeps its (sealed, run-scoped,
  // by then expired) state until a retry clears it. The previous deployment
  // ignores the column: it neither reads nor writes it.
  uploadState        Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  postJob          PostJob           @relation(fields: [postJobId], references: [id], onDelete: Cascade)
  socialConnection SocialConnection? @relation(fields: [socialConnectionId], references: [id], onDelete: SetNull)
  // Roadmap Phase 8 (analytics). Back-relation for PostMetric.postJobResultId,
  // which is onDelete:SetNull — so deleting this result NULLs the link but keeps
  // the metric row (its durable identity is the denormalized userId/platform/
  // externalPostId, not this FK). The metrics UI joins by (platform,
  // externalPostId), NOT via this relation, so a retry that changes the result's
  // externalPostId can leave >1 historical metric pointing here harmlessly.
  metrics          PostMetric[]

  // 2026-11-01 scale audit: every per-job read, update and include (Activity,
  // Queue, each publish step) filters by postJobId; also backs PostJob ->
  // PostJobResult ON DELETE CASCADE. Without it each was a full table scan.
  @@index([postJobId, platform])
  // 2026-11-01 scale audit: SocialConnection delete (Disconnect / Switch
  // account) runs ON DELETE SET NULL against this column.
  @@index([socialConnectionId])
  // 2026-11-01 scale audit: the hourly YouTube metrics selector filters by
  // platform and orders/ranges by createdAt. (The selector now orders by
  // metricsCheckedAt - see the index below; this one is kept: migrations in this
  // phase are additive only.)
  @@index([platform, createdAt])
  // 2026-11-01 scale audit (jobs): the metrics sync now filters by platform and
  // status and orders by metricsCheckedAt (least recently checked first).
  @@index([platform, status, metricsCheckedAt])
  // 2026-11-01 scale audit (db M5): publish-health's grouped COUNT filters by
  // workspaceId and ranges over updatedAt (the finish time). The heal step also
  // finds its NULL rows through it.
  @@index([workspaceId, updatedAt])
}

// Fixed-window rate-limit counters (see src/lib/rateLimit.ts).
// `key` encodes userId + route + time-window bucket; the limiter fails open,
// so a missing table or any store error must never break the guarded routes.
model RateLimitEntry {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

// Roadmap Phase 8 (analytics — post performance, §7.3). Per-post engagement
// snapshot fetched from the platform. YouTube-only in v1 (via the YouTube Data
// API v3 `videos.list?part=statistics`, which the app's EXISTING YouTube scope
// already permits — no new OAuth scope / owner reconnect); other platforms are
// intentionally not fetched (X needs paid tiers, GBP has no per-post insight
// API, LinkedIn personal shares expose little — see the cron's extension point).
//
// DECOUPLED FROM SocialConnection ON PURPOSE. `PostJobResult.socialConnection`
// is onDelete:Cascade, so disconnecting a platform deletes historical results —
// which would erode analytics. This row therefore DENORMALIZES the durable
// identity (`userId`, `platform`, `externalPostId`) onto itself and links back
// to the originating result only OPTIONALLY, via `postJobResultId` with
// onDelete:SetNull, so the metric SURVIVES a later result/connection deletion.
//
// SNAPSHOT STRATEGY: upsert-latest (one row per (platform, externalPostId),
// updated in place by the sync cron), NOT append-only time-series. v1 only needs
// "current" views/likes/comments; a single keyed row is the simplest thing that
// makes that queryable and is idempotent for the cron (repeated runs update, not
// duplicate). Switch to time-series later if history/graphs are needed.
model PostMetric {
  id              String   @id @default(cuid())
  userId          String
  workspaceId     String
  platform        Platform
  externalPostId  String
  // OPTIONAL link back to the result that produced this post. SetNull (not
  // Cascade) so the metric outlives the result. NEVER treat as required — the
  // denormalized userId/platform/externalPostId above is the durable identity
  // the UI/aggregate query by.
  postJobResultId String?
  fetchedAt       DateTime @default(now())
  views           Int?
  likes           Int?
  comments        Int?
  // Not exposed by the YouTube `videos.list` statistics part → always null for
  // YouTube v1. Kept in the schema for platform-extensibility.
  shares          Int?
  // Raw provider statistics payload for debugging/audit. MUST NOT be surfaced in
  // any DTO (SEC-1) — it is never a token store, but keep the read path minimal.
  raw             Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  postJobResult PostJobResult? @relation(fields: [postJobResultId], references: [id], onDelete: SetNull)
  // Owner FK is Cascade (review Minor #6): deleting a user removes their
  // metrics (no orphaned per-user rows). This is orthogonal to the
  // survives-a-disconnect design — that is served by `postJobResultId`'s
  // SetNull above, so a connection/result deletion still keeps the metric.
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Team Workspaces. Tenant scope for dashboard aggregate reads; userId above
  // stays as the connecting user (legacy compat — see
  // server/jobs/metricsScanner). Cascade: deleting a workspace removes its
  // metrics.
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // One current snapshot per external post. A YouTube video id is globally
  // unique per upload, so (platform, externalPostId) is a safe upsert key
  // without userId. This unique also serves as the cron's lookup index.
  @@unique([platform, externalPostId])
  // Dashboard aggregate / per-workspace reads (Team Workspaces). This replaced
  // the original @@index([userId]) for those reads, and migration 20260712120000
  // then dropped the DB index `PostMetric_userId_idx`. The userId index is back
  // below, for the User -> PostMetric cascade only.
  @@index([workspaceId])
  // 2026-11-01 scale audit: PostJobResult delete runs ON DELETE SET NULL
  // against this column.
  @@index([postJobResultId])
