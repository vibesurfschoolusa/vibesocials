// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`public pages with billing off > About renders today's page 1`] = `"<div class="flex min-h-screen justify-center bg-background px-4 py-10 text-foreground"><div class="w-full max-w-3xl rounded-[calc(var(--radius)+0.125rem)] border border-border bg-card p-6 text-card-foreground shadow-sm sm:p-8"><div class="mb-4 flex items-center justify-between gap-4"><h1 class="text-2xl font-semibold text-foreground">About Vibe Socials</h1><a class="shrink-0 text-xs text-muted-foreground underline underline-offset-2 hover:text-foreground" href="/">Back to <!-- -->Vibe Socials</a></div><div class="mb-6 text-sm text-muted-foreground"><p>Vibe Socials<!-- --> is a web app for small businesses and creators who post the same moment to several social networks. Upload a photo or video once, write a caption (or let AI draft one), choose where it goes, and publish now or schedule it.</p></div><div class="space-y-5 text-sm leading-relaxed text-muted-foreground"><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">Who it&#x27;s for</h2><p>Local businesses, tour and activity operators, shops and creators who don&#x27;t have time to post the same thing seven times. Anyone can sign up, connect their own accounts and invite their team.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">Where you can post</h2><ul class="flex flex-wrap gap-2"><li class="rounded-full border border-border px-3 py-1 text-xs">TikTok</li><li class="rounded-full border border-border px-3 py-1 text-xs">YouTube</li><li class="rounded-full border border-border px-3 py-1 text-xs">Instagram</li><li class="rounded-full border border-border px-3 py-1 text-xs">X</li><li class="rounded-full border border-border px-3 py-1 text-xs">LinkedIn</li><li class="rounded-full border border-border px-3 py-1 text-xs">Facebook Page</li><li class="rounded-full border border-border px-3 py-1 text-xs">Google Business Profile</li></ul></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">How it works</h2><ol class="list-decimal space-y-1 pl-5"><li>Create an account, then connect each platform with that platform&#x27;s own sign-in screen. You approve exactly what <!-- -->Vibe Socials<!-- --> may do, and can disconnect at any time.</li><li>Upload a photo or video and write a caption. For each platform you see a preview, and you choose its settings: for TikTok, who can view the post, whether comments, duets and stitches are allowed, and whether the post promotes a brand.</li><li>Publish now or schedule it. <!-- -->Vibe Socials<!-- --> posts through each platform&#x27;s official API and shows you where every post went, with a link to it.</li></ol></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">Who runs it</h2><p>Vibe Socials<!-- --> is built and operated by <!-- -->Vibe Surf School LLC<!-- -->, <!-- -->Florida, United States<!-- -->, for any business or creator who wants to post everywhere without doing it seven times.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">Contact</h2><div id="contact"><p>Questions, support or privacy requests:<!-- --> <a href="mailto:hello@vibesocials.wtf" class="underline underline-offset-2">hello@vibesocials.wtf</a>.</p></div></section><div class="flex flex-wrap gap-3 pt-2"><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[var(--radius)] font-medium transition-colors select-none outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 h-10 px-4 text-sm" href="/register">Create free account</a><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[var(--radius)] font-medium transition-colors select-none outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 border border-input bg-background text-foreground hover:bg-accent hover:text-accent-foreground h-10 px-4 text-sm" href="/login">Log in</a></div></div><nav aria-label="Site" class="mt-8 flex flex-wrap gap-x-4 gap-y-2 border-t border-border pt-4 text-xs text-muted-foreground"><a class="hover:text-foreground" href="/about">About</a><a class="hover:text-foreground" href="/help">Help</a><a class="hover:text-foreground" href="/about#contact">Contact</a><a class="hover:text-foreground" href="/privacy">Privacy Policy</a><a class="hover:text-foreground" href="/terms">Terms of Service</a><a class="hover:text-foreground" href="/data-deletion">Delete your data</a></nav></div></div>"`;

exports[`public pages with billing off > Help renders today's page 1`] = `"<div class="flex min-h-screen justify-center bg-background px-4 py-10 text-foreground"><div class="w-full max-w-3xl rounded-[calc(var(--radius)+0.125rem)] border border-border bg-card p-6 text-card-foreground shadow-sm sm:p-8"><div class="mb-4 flex items-center justify-between gap-4"><h1 class="text-2xl font-semibold text-foreground">Connecting your accounts</h1><a class="shrink-0 text-xs text-muted-foreground underline underline-offset-2 hover:text-foreground" href="/">Back to <!-- -->Vibe Socials</a></div><div class="mb-6 text-sm text-muted-foreground"><p>You connect accounts in Settings, under Connections. Only the workspace owner can connect an account. Each workspace holds one account per platform.</p></div><div class="space-y-5 text-sm leading-relaxed text-muted-foreground"><div id="tiktok" class="scroll-mt-6"><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">TikTok</h2><div class="space-y-3"><p role="note" class="rounded-[var(--radius)] border border-warning/40 bg-warning/10 px-3 py-2 text-foreground"><span class="font-semibold">Note: </span>TikTok is reviewing Vibe Socials. Until the review finishes, posts can only go to TikTok accounts that are set to private.</p><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">What you need</h3><ul class="list-disc space-y-1 pl-5"><li>A TikTok account.</li></ul></div><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">How to connect</h3><ol class="list-decimal space-y-1 pl-5"><li>Sign in on TikTok and allow access.</li><li>Each time you post, you choose who can see the video and the other TikTok settings shown on the Create page.</li></ol></div><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">Good to know</h3><ul class="list-disc space-y-1 pl-5"><li>Videos only.</li></ul></div></div></section></div><div id="youtube" class="scroll-mt-6"><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">YouTube</h2><div class="space-y-3"><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">What you need</h3><ul class="list-disc space-y-1 pl-5"><li>A YouTube channel on the Google account you sign in with.</li></ul></div><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">How to connect</h3><ol class="list-decimal space-y-1 pl-5"><li>Choose the Google account and channel, then allow access.</li></ol></div><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">Good to know</h3><ul class="list-disc space-y-1 pl-5"><li>Videos only.</li><li>To post to a channel you do not own, its owner adds your Google account as a manager (this works for Brand Account channels).</li></ul></div></div></section></div><div id="instagram" class="scroll-mt-6"><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">Instagram</h2><div class="space-y-3"><p role="note" class="rounded-[var(--radius)] border border-warning/40 bg-warning/10 px-3 py-2 text-foreground"><span class="font-semibold">Note: </span>Meta is reviewing Vibe Socials. Until the review finishes, connecting Facebook and Instagram is not open to every account yet. Write to hello@vibesocials.wtf and we will help you get set up.</p><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">What you need</h3><ul class="list-disc space-y-1 pl-5"><li>A professional (business) Instagram account that is linked to a Facebook Page you manage.</li><li>To switch: in the Instagram app, Settings, &quot;Account type and tools&quot;.</li></ul></div><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">How to connect</h3><ol class="list-decimal space-y-1 pl-5"><li>Connecting goes through Facebook&#x27;s sign-in.</li><li>If several Instagram accounts qualify, Vibe Socials asks which one.</li></ol></div><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">Good to know</h3><ul class="list-disc space-y-1 pl-5"><li>A personal Instagram account cannot be connected.</li><li>Photos are fitted to Instagram&#x27;s allowed shapes automatically.</li></ul></div></div></section></div><div id="x" class="scroll-mt-6"><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">X</h2><div class="space-y-3"><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">What you need</h3><ul class="list-disc space-y-1 pl-5"><li>The X account you want to post from.</li></ul></div><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">How to connect</h3><ol class="list-decimal space-y-1 pl-5"><li>Sign in to that account on X and authorize.</li></ol></div><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">Good to know</h3><ul class="list-disc space-y-1 pl-5"><li>X refuses posts from apps that @mention accounts, so Vibe Socials removes @mentions from the X version of a post.</li></ul></div></div></section></div><div id="linkedin" class="scroll-mt-6"><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">LinkedIn</h2><div class="space-y-3"><p role="note" class="rounded-[var(--radius)] border border-warning/40 bg-warning/10 px-3 py-2 text-foreground"><span class="font-semibold">Note: </span>LinkedIn is reviewing Vibe Socials. If connecting your company page fails before the review finishes, write to hello@vibesocials.wtf.</p><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">What you need</h3><ul class="list-disc space-y-1 pl-5"><li>You are a Super admin of the company page.</li></ul></div><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">How to connect</h3><ol class="list-decimal space-y-1 pl-5"><li>Vibe Socials first offers to open LinkedIn&#x27;s sign-out page, so that you can sign in as the right person.</li><li>If you administer several pages, it asks which one.</li></ol></div><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">Good to know</h3><ul class="list-disc space-y-1 pl-5"><li>Posts go out as the company.</li><li>Personal profiles are not supported.</li></ul></div></div></section></div><div id="facebook-page" class="scroll-mt-6"><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">Facebook Page</h2><div class="space-y-3"><p role="note" class="rounded-[var(--radius)] border border-warning/40 bg-warning/10 px-3 py-2 text-foreground"><span class="font-semibold">Note: </span>Meta is reviewing Vibe Socials. Until the review finishes, connecting Facebook and Instagram is not open to every account yet. Write to hello@vibesocials.wtf and we will help you get set up.</p><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">What you need</h3><ul class="list-disc space-y-1 pl-5"><li>You manage the Page (full control, or content access under the Page&#x27;s &quot;Page access&quot; settings).</li></ul></div><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">How to connect</h3><ol class="list-decimal space-y-1 pl-5"><li>In Settings, under Connections, click Connect.</li><li>Facebook asks which Pages to share and to confirm the permissions.</li><li>If you manage several Pages, Vibe Socials asks which one to post to.</li></ol></div><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">Good to know</h3><ul class="list-disc space-y-1 pl-5"><li>If the Page you want is not offered: on Facebook open Settings, Business integrations, remove Vibe Socials, then connect again. Facebook then asks which Pages to share.</li><li>Photos and videos are supported; videos are posted as Reels.</li></ul></div></div></section></div><div id="google-business-profile" class="scroll-mt-6"><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">Google Business Profile</h2><div class="space-y-3"><p role="note" class="rounded-[var(--radius)] border border-warning/40 bg-warning/10 px-3 py-2 text-foreground"><span class="font-semibold">Note: </span>Google is still verifying Vibe Socials. Until then Google shows a screen saying it has not verified this app. Choose &quot;Advanced&quot;, then &quot;Go to vibesocials.wtf&quot;, to continue.</p><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">What you need</h3><ul class="list-disc space-y-1 pl-5"><li>You are an owner or manager of the Business Profile.</li></ul></div><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">How to connect</h3><ol class="list-decimal space-y-1 pl-5"><li>Sign in with Google and allow access.</li><li>Then, back in Settings, choose the Maps location to post to.</li></ol></div><div><h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-foreground">Good to know</h3><ul class="list-disc space-y-1 pl-5"><li>Posts appear on the Maps listing.</li><li>Replies to Google reviews are on the Reviews page.</li></ul></div></div></section></div><div id="troubleshooting" class="scroll-mt-6"><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">When something goes wrong</h2><p class="mb-2">If a connection fails, Settings shows a message at the top of the page. It means one of these:</p><ul class="list-disc space-y-1 pl-5"><li><span class="text-foreground">You cancelled on the platform&#x27;s screen.</span> <!-- -->Nothing was connected. Click Connect to try again.</li><li><span class="text-foreground">The connection was started from a different account.</span> <!-- -->Sign in to the <!-- -->Vibe Socials<!-- --> account you want to connect, then try again.</li><li><span class="text-foreground">You are not the workspace owner.</span> Only the owner can connect accounts. Ask them to connect it.</li><li><span class="text-foreground">The LinkedIn account is not a Super admin of any company page.</span> <!-- -->Sign in to LinkedIn with an account that is a Super admin of your page, then click Connect again.</li></ul><p class="mt-2">If it still fails, write to<!-- --> <a href="mailto:hello@vibesocials.wtf" class="underline underline-offset-2">hello@vibesocials.wtf</a> <!-- -->and say which platform you were connecting.</p></section></div><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">Removing access</h2><p>Disconnect in Settings removes the connection from <!-- -->Vibe Socials<!-- -->. Each platform also lets you remove the access you gave <!-- -->Vibe Socials<!-- --> in its own settings.</p></section></div><nav aria-label="Site" class="mt-8 flex flex-wrap gap-x-4 gap-y-2 border-t border-border pt-4 text-xs text-muted-foreground"><a class="hover:text-foreground" href="/about">About</a><a class="hover:text-foreground" href="/help">Help</a><a class="hover:text-foreground" href="/about#contact">Contact</a><a class="hover:text-foreground" href="/privacy">Privacy Policy</a><a class="hover:text-foreground" href="/terms">Terms of Service</a><a class="hover:text-foreground" href="/data-deletion">Delete your data</a></nav></div></div>"`;

exports[`public pages with billing off > Log in renders today's page 1`] = `"<!--$--><div class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-background px-4 py-16"><div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-primary/5 via-background to-background"></div><div aria-hidden="true" class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-72 w-72 -translate-x-1/2 rounded-full bg-primary/10 blur-3xl"></div><div class="w-full max-w-md"><div class="mb-6 flex justify-center"><a aria-label="Vibe Socials home" class="rounded-2xl outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background" href="/"><span aria-hidden="true" class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 to-indigo-700 text-lg font-bold text-white shadow-lg">VS</span></a></div><div class="rounded-[calc(var(--radius)+0.125rem)] border border-border bg-card text-card-foreground shadow-sm"><div class="flex flex-col gap-1.5 p-6"><h1 class="text-2xl font-semibold leading-none tracking-tight text-foreground">Log in</h1><p class="text-sm text-muted-foreground">Welcome back to Vibe Socials</p></div><div class="p-6 pt-0"><form class="space-y-4"><div class="space-y-1.5"><label class="text-sm font-medium leading-none text-foreground select-none" for="email">Email</label><input type="email" class="w-full rounded-[var(--radius)] border border-input bg-background text-sm text-foreground shadow-xs transition-colors placeholder:text-muted-foreground outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-50 aria-[invalid=true]:border-destructive aria-[invalid=true]:focus-visible:ring-destructive/40 h-10 px-3 py-2 file:mr-3 file:h-6 file:cursor-pointer file:rounded-[calc(var(--radius)-0.125rem)] file:border-0 file:bg-secondary file:px-2.5 file:text-sm file:font-medium file:text-secondary-foreground hover:file:bg-secondary/80" id="email" autoComplete="email" required="" value=""/></div><div class="space-y-1.5"><div class="flex items-center justify-between"><label class="text-sm font-medium leading-none text-foreground select-none" for="password">Password</label><a class="text-sm font-medium text-primary outline-none hover:underline focus-visible:underline" href="/forgot-password">Forgot password?</a></div><div class="relative"><input type="password" class="w-full rounded-[var(--radius)] border border-input bg-background text-sm text-foreground shadow-xs transition-colors placeholder:text-muted-foreground outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-50 aria-[invalid=true]:border-destructive aria-[invalid=true]:focus-visible:ring-destructive/40 h-10 px-3 py-2 file:mr-3 file:h-6 file:cursor-pointer file:rounded-[calc(var(--radius)-0.125rem)] file:border-0 file:bg-secondary file:px-2.5 file:text-sm file:font-medium file:text-secondary-foreground hover:file:bg-secondary/80 pl-3 pr-10" id="password" autoComplete="current-password" required="" value=""/><button type="button" aria-label="Show password" aria-pressed="false" class="absolute inset-y-0 right-0 flex items-center px-3 text-muted-foreground outline-none transition-colors hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye h-4 w-4" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></button></div></div><button type="submit" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[var(--radius)] font-medium transition-colors select-none outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 h-10 px-4 text-sm w-full">Sign in</button></form><p class="mt-6 text-center text-sm text-muted-foreground">Need an account?<!-- --> <a class="font-semibold text-primary outline-none hover:underline focus-visible:underline" href="/register">Create one</a></p></div></div></div></div><!--/$-->"`;

exports[`public pages with billing off > Privacy renders today's page 1`] = `"<div class="flex min-h-screen justify-center bg-background px-4 py-10 text-foreground"><div class="w-full max-w-3xl rounded-[calc(var(--radius)+0.125rem)] border border-border bg-card p-6 text-card-foreground shadow-sm sm:p-8"><div class="mb-4 flex items-center justify-between gap-4"><h1 class="text-2xl font-semibold text-foreground">Privacy Policy</h1><a class="shrink-0 text-xs text-muted-foreground underline underline-offset-2 hover:text-foreground" href="/">Back to <!-- -->Vibe Socials</a></div><p class="mb-4 text-xs text-muted-foreground">Last updated: <!-- -->November 12, 2026</p><div class="mb-6 text-sm text-muted-foreground"><p>Vibe Socials<!-- --> (&quot;we&quot;, &quot;the Service&quot;) is a web app that lets businesses and creators upload a photo or video once and publish it to the social media accounts they connect. <!-- -->Vibe Socials<!-- --> is operated by <!-- -->Vibe Surf School LLC<!-- -->, <!-- -->Florida, United States<!-- -->. This policy explains what we collect, why, who processes it, and how you can delete it.</p></div><div class="space-y-5 text-sm leading-relaxed text-muted-foreground"><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">1. Information we collect</h2><ul class="list-disc space-y-1 pl-5"><li><strong class="text-foreground">Account information:</strong> your name, email address and a hashed password (or your Google sign-in, if you choose it), your workspace and the teammates you invite.</li><li><strong class="text-foreground">Content you upload:</strong> the photos and videos you add, your captions, and the post settings you choose.</li><li><strong class="text-foreground">Connected platform accounts:</strong> when you connect a platform, we receive the access permissions you approve on that platform&#x27;s own sign-in screen, your account&#x27;s identifier and display name, and the access and refresh tokens that let us publish for you.</li><li><strong class="text-foreground">Publishing results:</strong> the post IDs, links, statuses and error messages each platform returns, and (for YouTube) view and engagement counts for posts made through the Service.</li><li><strong class="text-foreground">Google Business reviews:</strong> if you connect a Google Business Profile, the reviews you open in the Service and the replies you send.</li><li><strong class="text-foreground">Technical information:</strong> basic request data such as IP address and browser type in short-lived server logs, used for security and to prevent abuse.</li></ul></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">2. How we use it</h2><p>Only to provide the Service you asked for:</p><ul class="mt-1 list-disc space-y-1 pl-5"><li>to sign you in and run your account and workspace;</li><li>to publish or schedule the posts you create, to the platforms you choose, when you choose;</li><li>to show you where each post went, keep your connections working, and email you when a post finishes (you can turn these emails off in Settings);</li><li>to suggest captions with AI, automatically when you add a photo or video (you can turn this off on the Create page) or when you ask, and to suggest review replies when you ask;</li><li>to suggest places when you add a location to a post.</li></ul><p class="mt-2">We do not sell your information, use it for advertising, or post anything you did not create and confirm.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">3. TikTok</h2><p>When you connect TikTok, you approve these permissions on TikTok&#x27;s own screen:</p><ul class="mt-1 list-disc space-y-1 pl-5"><li><strong class="text-foreground">user.info.basic:</strong> your TikTok account&#x27;s open ID, display name and avatar, shown so you know which account a post goes to.</li><li><strong class="text-foreground">video.publish / video.upload:</strong> posting the videos you choose to your account, with the privacy, interaction and content-disclosure settings you select for each post. Before each post we ask TikTok for your account&#x27;s current posting options (for example, which privacy levels you can use).</li></ul><p class="mt-2">We do not read your TikTok videos, followers, likes or messages. Disconnecting TikTok in Settings deletes the tokens we hold; you can also remove <!-- -->Vibe Socials<!-- -->&#x27;s access from your TikTok app settings at any time.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">4. YouTube, Google and other platforms</h2><p>Vibe Socials<!-- --> uses YouTube API Services. By connecting YouTube you agree to the<!-- --> <a href="https://www.youtube.com/t/terms" class="underline underline-offset-2">YouTube Terms of Service</a>, and Google&#x27;s handling of your data is described in the<!-- --> <a href="https://policies.google.com/privacy" class="underline underline-offset-2">Google Privacy Policy</a>. When you connect YouTube or Google Business Profile, you approve these permissions on Google&#x27;s own screen, and we use them only as follows:</p><ul class="mt-1 list-disc space-y-1 pl-5"><li><strong class="text-foreground">YouTube upload:</strong> uploading the videos you choose to your channel, with the title, description and privacy you set.</li><li><strong class="text-foreground">YouTube read-only:</strong> your channel&#x27;s name, shown in Settings, and the view, like and comment counts of videos you posted through<!-- --> <!-- -->Vibe Socials<!-- -->, shown on your dashboard.</li><li><strong class="text-foreground">Google Business Profile:</strong> creating the posts you publish, adding your videos to your profile&#x27;s photos and videos, and showing your reviews and posting the replies you write or approve.</li></ul><p class="mt-2">Vibe Socials<!-- -->&#x27;s use and transfer of information received from Google APIs adheres to the<!-- --> <a href="https://developers.google.com/terms/api-services-user-data-policy" class="underline underline-offset-2">Google API Services User Data Policy</a>, including the Limited Use requirements. We never sell Google user data, use it for advertising, or use it to train AI models. A review&#x27;s text goes to our AI provider only when you ask for a reply suggestion. You can revoke <!-- -->Vibe Socials<!-- -->&#x27;s access at any time in your<!-- --> <a href="https://security.google.com/settings/security/permissions" class="underline underline-offset-2">Google account permissions</a>; disconnecting in Settings deletes the tokens and YouTube data we hold.</p><p class="mt-2">The same approach applies to Facebook Pages and Instagram (Meta), LinkedIn, Pinterest and X: we request only the permissions needed to publish your posts, and use them only for that. Each platform&#x27;s own terms and privacy policy also apply to what you post there.</p><p class="mt-2">For LinkedIn, you approve two permissions on LinkedIn&#x27;s own screen: posting as your company page, and finding the pages you administer so you can choose one. We store the page&#x27;s ID and name to show it in Settings and to publish to it. We do not read your LinkedIn profile, your connections, or comments and reactions on your posts.</p><p class="mt-2">For Pinterest, you approve on Pinterest&#x27;s own screen: creating Pins, and reading your boards and your username. We read your list of boards when you connect, so you can choose the board your Pins go on. We store your username and that board&#x27;s ID and name, to show them in Settings and to publish to the board, and the ID of each Pin we create, to link to it. We do not read your other Pins, your followers, your messages or your analytics, and we never save other people&#x27;s Pins, follow accounts or comment for you. You can remove<!-- --> <!-- -->Vibe Socials<!-- -->&#x27;s access at any time in your Pinterest settings under Security; disconnecting in Settings deletes the tokens and the Pinterest details we hold.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">5. Who processes your information</h2><p>We use these service providers, only to run the Service:</p><ul class="mt-1 list-disc space-y-1 pl-5"><li>Vercel (hosting and media file storage);</li><li>Neon (database);</li><li>Inngest (running scheduled and background publishing jobs);</li><li>Resend (account and notification emails);</li><li>xAI or OpenAI (AI caption and reply suggestions, for the media and text involved);</li><li>Google Maps Platform (place search, when you add a location to a post).</li></ul><p class="mt-2">Your content is also sent to each social platform you choose to post to. We share information with authorities only where the law requires it.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">6. How long we keep it</h2><ul class="list-disc space-y-1 pl-5"><li>Photos and videos you have posted are deleted 30 days after they were last used in a post. Uploads you keep in your media library without posting stay until you delete them there or delete your account.</li><li>Platform tokens are deleted when you disconnect that platform.</li><li>YouTube view, like and comment counts are refreshed while YouTube is connected. Counts not refreshed for 30 days are deleted, and disconnecting YouTube deletes them all at once.</li><li>A connected LinkedIn page&#x27;s name is read again from LinkedIn every day while the connection works. A name not refreshed for eight weeks is deleted; disconnecting LinkedIn deletes it at once.</li><li>Your account, posts and publishing history are kept until you delete your account.</li><li>Server logs are kept for a short time, typically days.</li></ul></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">7. Your choices and deletion</h2><p>You can disconnect any platform in Settings at any time. To delete your account and all associated data, follow the steps on our<!-- --> <a class="underline underline-offset-2" href="/data-deletion">data deletion page</a> <!-- -->or email <a href="mailto:hello@vibesocials.wtf" class="underline underline-offset-2">hello@vibesocials.wtf</a>. You can also ask us for a copy of your information or to correct it.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">8. Security</h2><p>All traffic is encrypted (HTTPS). Platform access tokens are encrypted at rest, passwords are stored only as hashes, and each workspace can only see its own data.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">9. Children</h2><p>The Service is meant for businesses and creators aged 18 or over. We do not knowingly collect information from children under 13.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">10. Changes</h2><p>We will post any change to this policy here and update the date above. For a significant change, we will also notify account holders by email.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">11. Contact</h2><p>Vibe Surf School LLC<!-- --> (<!-- -->Vibe Socials<!-- -->), <!-- -->Florida, United States<!-- -->. Email: <a href="mailto:hello@vibesocials.wtf" class="underline underline-offset-2">hello@vibesocials.wtf</a>.</p></section></div><nav aria-label="Site" class="mt-8 flex flex-wrap gap-x-4 gap-y-2 border-t border-border pt-4 text-xs text-muted-foreground"><a class="hover:text-foreground" href="/about">About</a><a class="hover:text-foreground" href="/help">Help</a><a class="hover:text-foreground" href="/about#contact">Contact</a><a class="hover:text-foreground" href="/privacy">Privacy Policy</a><a class="hover:text-foreground" href="/terms">Terms of Service</a><a class="hover:text-foreground" href="/data-deletion">Delete your data</a></nav></div></div>"`;

exports[`public pages with billing off > Register renders today's page 1`] = `"<!--$--><div class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden bg-background px-4 py-16"><div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-primary/5 via-background to-background"></div><div aria-hidden="true" class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-72 w-72 -translate-x-1/2 rounded-full bg-primary/10 blur-3xl"></div><div class="w-full max-w-md"><div class="mb-6 flex justify-center"><a aria-label="Vibe Socials home" class="rounded-2xl outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background" href="/"><span aria-hidden="true" class="flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 to-indigo-700 text-lg font-bold text-white shadow-lg">VS</span></a></div><div class="rounded-[calc(var(--radius)+0.125rem)] border border-border bg-card text-card-foreground shadow-sm"><div class="flex flex-col gap-1.5 p-6"><h1 class="text-2xl font-semibold leading-none tracking-tight text-foreground">Create an account</h1><p class="text-sm text-muted-foreground">Join Vibe Socials today</p></div><div class="p-6 pt-0"><form class="space-y-4"><div class="space-y-1.5"><label class="text-sm font-medium leading-none text-foreground select-none" for="name">Name <span class="font-normal text-muted-foreground">(optional)</span></label><input type="text" class="w-full rounded-[var(--radius)] border border-input bg-background text-sm text-foreground shadow-xs transition-colors placeholder:text-muted-foreground outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-50 aria-[invalid=true]:border-destructive aria-[invalid=true]:focus-visible:ring-destructive/40 h-10 px-3 py-2 file:mr-3 file:h-6 file:cursor-pointer file:rounded-[calc(var(--radius)-0.125rem)] file:border-0 file:bg-secondary file:px-2.5 file:text-sm file:font-medium file:text-secondary-foreground hover:file:bg-secondary/80" id="name" autoComplete="name" value=""/></div><div class="space-y-1.5"><label class="text-sm font-medium leading-none text-foreground select-none" for="email">Email</label><input type="email" class="w-full rounded-[var(--radius)] border border-input bg-background text-sm text-foreground shadow-xs transition-colors placeholder:text-muted-foreground outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-50 aria-[invalid=true]:border-destructive aria-[invalid=true]:focus-visible:ring-destructive/40 h-10 px-3 py-2 file:mr-3 file:h-6 file:cursor-pointer file:rounded-[calc(var(--radius)-0.125rem)] file:border-0 file:bg-secondary file:px-2.5 file:text-sm file:font-medium file:text-secondary-foreground hover:file:bg-secondary/80" id="email" autoComplete="email" required="" value=""/></div><div class="space-y-1.5"><label class="text-sm font-medium leading-none text-foreground select-none" for="password">Password</label><div class="relative"><input type="password" class="w-full rounded-[var(--radius)] border border-input bg-background text-sm text-foreground shadow-xs transition-colors placeholder:text-muted-foreground outline-none focus-visible:border-ring focus-visible:ring-2 focus-visible:ring-ring/40 disabled:cursor-not-allowed disabled:opacity-50 aria-[invalid=true]:border-destructive aria-[invalid=true]:focus-visible:ring-destructive/40 h-10 px-3 py-2 file:mr-3 file:h-6 file:cursor-pointer file:rounded-[calc(var(--radius)-0.125rem)] file:border-0 file:bg-secondary file:px-2.5 file:text-sm file:font-medium file:text-secondary-foreground hover:file:bg-secondary/80 pl-3 pr-10" id="password" autoComplete="new-password" required="" minLength="8" value=""/><button type="button" aria-label="Show password" aria-pressed="false" class="absolute inset-y-0 right-0 flex items-center px-3 text-muted-foreground outline-none transition-colors hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye h-4 w-4" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></button></div><p class="text-xs text-muted-foreground">At least 8 characters.</p></div><button type="submit" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[var(--radius)] font-medium transition-colors select-none outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 h-10 px-4 text-sm w-full">Create account</button></form><p class="mt-6 text-center text-sm text-muted-foreground">Already have an account?<!-- --> <a class="font-semibold text-primary outline-none hover:underline focus-visible:underline" href="/login">Log in</a></p></div></div></div></div><!--/$-->"`;

exports[`public pages with billing off > Terms renders today's page 1`] = `"<div class="flex min-h-screen justify-center bg-background px-4 py-10 text-foreground"><div class="w-full max-w-3xl rounded-[calc(var(--radius)+0.125rem)] border border-border bg-card p-6 text-card-foreground shadow-sm sm:p-8"><div class="mb-4 flex items-center justify-between gap-4"><h1 class="text-2xl font-semibold text-foreground">Terms of Service</h1><a class="shrink-0 text-xs text-muted-foreground underline underline-offset-2 hover:text-foreground" href="/">Back to <!-- -->Vibe Socials</a></div><p class="mb-4 text-xs text-muted-foreground">Last updated: <!-- -->November 12, 2026</p><div class="mb-6 text-sm text-muted-foreground"><p>These Terms govern your use of <!-- -->Vibe Socials<!-- --> (the &quot;Service&quot;), operated by<!-- --> <!-- -->Vibe Surf School LLC<!-- -->, <!-- -->Florida, United States<!-- --> (&quot;we&quot;). By creating an account or using the Service, you agree to them.</p></div><div class="space-y-5 text-sm leading-relaxed text-muted-foreground"><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">1. The Service</h2><p>Vibe Socials<!-- --> lets businesses and creators upload a photo or video once, write or AI-assist a caption, and publish or schedule it to the social media accounts they connect: TikTok, Instagram, Facebook Pages, YouTube, LinkedIn, X and Google Business Profile. Anyone aged 18 or over can create an account; a workspace can be shared with teammates.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">2. Your account</h2><ul class="list-disc space-y-1 pl-5"><li>Keep your sign-in details secure and tell us about any unauthorized use.</li><li>Connect only accounts you own or are authorized to manage.</li><li>Workspace owners decide who may post to the workspace&#x27;s connected accounts.</li></ul></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">3. Your content</h2><p>You keep all rights to what you upload. You give us permission to store, process and send your content only as needed to publish it where and when you choose. Nothing is posted unless you create the post and confirm it. You are responsible for your content and for having the rights to it, including any music.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">4. Platform rules</h2><p>You must follow the terms and policies of each platform you post to. For TikTok, that includes TikTok&#x27;s<!-- --> <a href="https://www.tiktok.com/legal/page/us/terms-of-service/en" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Terms of Service</a>,<!-- --> <a href="https://www.tiktok.com/community-guidelines" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Community Guidelines</a>,<!-- --> <a href="https://www.tiktok.com/legal/page/global/music-usage-confirmation/en" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Music Usage Confirmation</a> <!-- -->and, for paid partnerships,<!-- --> <a href="https://www.tiktok.com/legal/page/global/bc-policy/en" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Branded Content Policy</a>. If your content promotes a brand, product or service, disclose it using the settings the Service shows for that platform.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">5. Acceptable use</h2><p>Don&#x27;t use the Service to post illegal, hateful, harassing, deceptive or infringing content, to send spam or mass unsolicited mentions, to impersonate others, or to get around a platform&#x27;s limits. Don&#x27;t try to access other workspaces or interfere with the Service.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">6. Third-party platforms</h2><p>Vibe Socials<!-- --> is not affiliated with or endorsed by TikTok, Meta, Google, LinkedIn, Pinterest or X. Each platform decides whether and how your post appears, and may change its features or limits at any time.</p><p class="mt-2">Vibe Socials<!-- --> uses YouTube API Services. If you connect YouTube, you agree to be bound by the<!-- --> <a href="https://www.youtube.com/t/terms" class="underline underline-offset-2">YouTube Terms of Service</a>.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">7. Fees</h2><p>The Service is currently free. If we introduce paid plans, we will tell you and show the price before anything is charged.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">8. Availability and changes</h2><p>We work to keep the Service running and your posts reliable, but we can&#x27;t guarantee uninterrupted operation. We may change features, and will post changes to these Terms here with a new date.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">9. Ending your use</h2><p>You can stop using the Service and delete your account at any time (see<!-- --> <a class="underline underline-offset-2" href="/data-deletion">Delete your data</a>). We may suspend accounts that break these Terms or a platform&#x27;s rules.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">10. Disclaimer and liability</h2><p>The Service is provided &quot;as is&quot;. To the extent the law allows, we are not liable for indirect or consequential losses, lost data, or a platform&#x27;s actions on your account, and our total liability is limited to the amount you paid us in the 12 months before the claim (currently zero).</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">11. Governing law</h2><p>These Terms are governed by the laws of the State of Florida, United States.</p></section><section><h2 class="mb-1.5 text-sm font-semibold text-foreground">12. Contact</h2><p>Vibe Surf School LLC<!-- --> (<!-- -->Vibe Socials<!-- -->), <!-- -->Florida, United States<!-- -->. Email: <a href="mailto:hello@vibesocials.wtf" class="underline underline-offset-2">hello@vibesocials.wtf</a>.</p></section></div><nav aria-label="Site" class="mt-8 flex flex-wrap gap-x-4 gap-y-2 border-t border-border pt-4 text-xs text-muted-foreground"><a class="hover:text-foreground" href="/about">About</a><a class="hover:text-foreground" href="/help">Help</a><a class="hover:text-foreground" href="/about#contact">Contact</a><a class="hover:text-foreground" href="/privacy">Privacy Policy</a><a class="hover:text-foreground" href="/terms">Terms of Service</a><a class="hover:text-foreground" href="/data-deletion">Delete your data</a></nav></div></div>"`;

exports[`public pages with billing off > the landing page renders today's page 1`] = `"<div class="relative min-h-screen overflow-hidden bg-background"><div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-primary/5 via-background to-background"></div><div aria-hidden="true" class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-72 w-72 -translate-x-1/2 rounded-full bg-primary/10 blur-3xl"></div><header class="mx-auto flex w-full max-w-5xl items-center justify-between px-4 py-5 md:px-6"><span class="flex items-center gap-2.5"><span aria-hidden="true" class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-indigo-500 to-indigo-700 text-xs font-bold text-white">VS</span><span class="text-sm font-semibold text-foreground">Vibe Socials</span></span><nav aria-label="Main" class="flex items-center gap-1"><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[var(--radius)] font-medium transition-colors select-none outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 text-foreground hover:bg-accent hover:text-accent-foreground h-8 px-3 text-sm" href="/about">About</a><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[var(--radius)] font-medium transition-colors select-none outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 text-foreground hover:bg-accent hover:text-accent-foreground h-8 px-3 text-sm" href="/login">Log in</a></nav></header><main class="mx-auto w-full max-w-5xl px-4 md:px-6"><section class="flex flex-col items-center pb-14 pt-10 text-center sm:pt-16"><h1 class="max-w-2xl text-4xl font-bold tracking-tight text-foreground sm:text-5xl">Upload once. Post everywhere.</h1><p class="mt-4 max-w-xl text-base text-muted-foreground sm:text-lg">One composer for your video, photo, and text posts — published or scheduled across every platform you&#x27;re on, with your whole team in one workspace.</p><div class="mt-8 flex w-full max-w-md flex-col gap-3 sm:flex-row"><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[var(--radius)] font-medium transition-colors select-none outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 h-11 px-6 text-base flex-1" href="/register">Create free account</a><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[var(--radius)] font-medium transition-colors select-none outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 border border-input bg-background text-foreground hover:bg-accent hover:text-accent-foreground h-11 px-6 text-base flex-1" href="/login">Log in</a></div><ul class="mt-10 flex max-w-2xl flex-wrap items-center justify-center gap-2"><li class="rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground">TikTok</li><li class="rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground">YouTube</li><li class="rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground">Instagram</li><li class="rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground">X</li><li class="rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground">LinkedIn</li><li class="rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground">Facebook Page</li><li class="rounded-full border border-border bg-card px-3 py-1 text-xs font-medium text-muted-foreground">Google Business Profile</li></ul></section><section aria-labelledby="features-heading" class="pb-14"><h2 id="features-heading" class="text-center text-2xl font-bold tracking-tight text-foreground">Everything your posts need, in one place</h2><div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"><div class="rounded-xl border border-border bg-card p-5"><span aria-hidden="true" class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send h-4.5 w-4.5" aria-hidden="true"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path><path d="m21.854 2.147-10.94 10.939"></path></svg></span><h3 class="mt-3 text-sm font-semibold text-foreground">One composer, every platform</h3><p class="mt-1 text-sm text-muted-foreground">Write a caption, attach your media, pick platforms — we handle each network&#x27;s formats and limits.</p></div><div class="rounded-xl border border-border bg-card p-5"><span aria-hidden="true" class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-clock h-4.5 w-4.5" aria-hidden="true"><path d="M16 14v2.2l1.6 1"></path><path d="M16 2v4"></path><path d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3.5"></path><path d="M3 10h5"></path><path d="M8 2v4"></path><circle cx="16" cy="16" r="6"></circle></svg></span><h3 class="mt-3 text-sm font-semibold text-foreground">Schedule and drafts</h3><p class="mt-1 text-sm text-muted-foreground">Publish now, schedule for later, or park it as a draft. Cancel or retry any time from the queue.</p></div><div class="rounded-xl border border-border bg-card p-5"><span aria-hidden="true" class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles h-4.5 w-4.5" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg></span><h3 class="mt-3 text-sm font-semibold text-foreground">AI captions</h3><p class="mt-1 text-sm text-muted-foreground">Auto-draft a caption from your media, or enhance the one you wrote — then edit before anything ships.</p></div><div class="rounded-xl border border-border bg-card p-5"><span aria-hidden="true" class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users h-4.5 w-4.5" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg></span><h3 class="mt-3 text-sm font-semibold text-foreground">Team workspaces</h3><p class="mt-1 text-sm text-muted-foreground">Invite teammates into a shared workspace with connected accounts, activity, and media in common.</p></div><div class="rounded-xl border border-border bg-card p-5"><span aria-hidden="true" class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity h-4.5 w-4.5" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg></span><h3 class="mt-3 text-sm font-semibold text-foreground">Activity and connection health</h3><p class="mt-1 text-sm text-muted-foreground">See exactly where each post landed, and get flagged the moment a platform connection needs attention.</p></div><div class="rounded-xl border border-border bg-card p-5"><span aria-hidden="true" class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star h-4.5 w-4.5" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg></span><h3 class="mt-3 text-sm font-semibold text-foreground">Google reviews inbox</h3><p class="mt-1 text-sm text-muted-foreground">Read and answer your Google Business reviews — with an AI-drafted reply one click away.</p></div></div></section><section aria-labelledby="how-heading" class="pb-14"><h2 id="how-heading" class="text-center text-2xl font-bold tracking-tight text-foreground">Up and running in minutes</h2><ol class="mx-auto mt-8 grid max-w-3xl grid-cols-1 gap-4 sm:grid-cols-3"><li class="flex flex-col items-center rounded-xl border border-border bg-card p-5 text-center"><span aria-hidden="true" class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link2 lucide-link-2 h-4.5 w-4.5" aria-hidden="true"><path d="M9 17H7A5 5 0 0 1 7 7h2"></path><path d="M15 7h2a5 5 0 1 1 0 10h-2"></path><line x1="8" x2="16" y1="12" y2="12"></line></svg></span><span class="mt-3 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Step <!-- -->1</span><h3 class="mt-1 text-sm font-semibold text-foreground">Connect your accounts</h3><p class="mt-1 text-sm text-muted-foreground">Link the platforms you post to with a secure sign-in for each.</p></li><li class="flex flex-col items-center rounded-xl border border-border bg-card p-5 text-center"><span aria-hidden="true" class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen h-4.5 w-4.5" aria-hidden="true"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"></path></svg></span><span class="mt-3 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Step <!-- -->2</span><h3 class="mt-1 text-sm font-semibold text-foreground">Compose once</h3><p class="mt-1 text-sm text-muted-foreground">Add media and a caption; tailor per-platform details if you want.</p></li><li class="flex flex-col items-center rounded-xl border border-border bg-card p-5 text-center"><span aria-hidden="true" class="flex h-9 w-9 items-center justify-center rounded-full bg-primary/10 text-primary"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send h-4.5 w-4.5" aria-hidden="true"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path><path d="m21.854 2.147-10.94 10.939"></path></svg></span><span class="mt-3 text-xs font-semibold uppercase tracking-wide text-muted-foreground">Step <!-- -->3</span><h3 class="mt-1 text-sm font-semibold text-foreground">Publish or schedule</h3><p class="mt-1 text-sm text-muted-foreground">Ship it everywhere at once and watch the results roll into your activity feed.</p></li></ol></section><section class="pb-16"><div class="flex flex-col items-center gap-4 rounded-2xl border border-border bg-card px-6 py-10 text-center"><h2 class="text-2xl font-bold tracking-tight text-foreground">Ready to post everywhere?</h2><p class="max-w-md text-sm text-muted-foreground">Create a free account — no credit card, your first workspace is set up automatically.</p><a class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[var(--radius)] font-medium transition-colors select-none outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground shadow-xs hover:bg-primary/90 h-11 px-6 text-base" href="/register">Create free account</a></div></section></main><footer class="border-t border-border"><div class="mx-auto flex w-full max-w-5xl flex-col items-center justify-between gap-3 px-4 py-6 text-sm text-muted-foreground sm:flex-row md:px-6"><span>© <!-- -->2026<!-- --> <!-- -->Vibe Socials<!-- --> · operated by <!-- -->Vibe Surf School LLC</span><nav aria-label="Legal" class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1"><a class="hover:text-foreground" href="/about">About</a><a class="hover:text-foreground" href="/about#contact">Contact</a><a class="hover:text-foreground" href="/privacy">Privacy</a><a class="hover:text-foreground" href="/terms">Terms</a><a class="hover:text-foreground" href="/data-deletion">Delete your data</a></nav></div></footer></div>"`;
